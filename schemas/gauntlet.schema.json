{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Gauntlet Runtime Configuration",
  "type": "object",
  "required": ["version","task","providers","agents","workflow"],
  "properties": {
    "version": {"const": 1},
    "workspace": {"type": "string"},
    "task": {"type":"object","required":["objective"],"properties":{"objective":{"type":"string"},"acceptanceCriteria":{"type":"array","items":{"type":"string"}}}},
    "providers": {"type":"object","additionalProperties":{"type":"object"}},
    "agents": {"type":"array","minItems":1,"items":{"type":"object","required":["id","provider","model","roles"],"properties":{"id":{"type":"string"},"provider":{"type":"string"},"model":{"type":"string"},"mode":{"enum":["workspace","patch","advisory"]},"roles":{"type":"array","items":{"enum":["orchestrator","architect","builder","critic"]}},"capabilities":{"type":"array","items":{"type":"string"}}}}},
    "workflow": {"type":"object","required":["builder","critics"],"properties":{"builder":{"type":"string"},"critics":{"type":"array","minItems":1,"items":{"type":"string"}},"maxRounds":{"type":"integer","minimum":1,"maximum":20},"passPolicy":{"enum":["all","majority"]},"requireIndependentCritic":{"type":"boolean"},"requireCleanWorkspace":{"type":"boolean"}}},
    "verification": {"type":"object"},
    "security": {"type":"object"}
  }
}
